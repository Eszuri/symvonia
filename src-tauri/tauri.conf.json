{
    "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
    "productName": "Symvonia",
    "version": "1.0.7",
    "identifier": "com.symvonia.player",
    "build": {
        "frontendDist": "../out",
        "devUrl": "http://localhost:3000",
        "beforeDevCommand": "npm run dev",
        "beforeBuildCommand": "npm run build"
    },
    "app": {
        "windows": [
            {
                "label": "main",
                "title": "Symvonia",
                "width": 1000,
                "height": 700,
                "minWidth": 800,
                "minHeight": 700,
                "resizable": true,
                "fullscreen": false,
                "maximized": true,
                "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,HardwareMediaKeyHandling,MediaSessionService,GlobalMediaControls"
            },
            {
                "label": "media-overlay",
                "title": "Symvonia Media Overlay",
                "url": "media-overlay",
                "width": 340,
                "height": 140,
                "resizable": false,
                "decorations": false,
                "transparent": true,
                "alwaysOnTop": true,
                "skipTaskbar": true,
                "visible": false,
                "shadow": false,
                "focus": false,
                "acceptFirstMouse": true,
                "x": 20,
                "y": 20,
                "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,HardwareMediaKeyHandling,MediaSessionService,GlobalMediaControls"
            }
        ],
        "security": {
            "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset: http://asset.localhost https://asset.localhost https: http:; media-src 'self' blob: stream: http://stream.localhost https://stream.localhost; connect-src 'self' ipc: http://ipc.localhost https://ipc.localhost stream: http://stream.localhost https://stream.localhost; object-src 'none'; base-uri 'self'; frame-src 'none'",
            "devCsp": "default-src 'self' http://localhost:3000; script-src 'self' 'unsafe-inline' 'unsafe-eval' http://localhost:3000; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset: http://asset.localhost https://asset.localhost https: http:; media-src 'self' blob: stream: http://stream.localhost https://stream.localhost; connect-src 'self' ipc: http://ipc.localhost https://ipc.localhost stream: http://stream.localhost https://stream.localhost http://localhost:3000 ws://localhost:3000; object-src 'none'; base-uri 'self'; frame-src 'none'",
            "assetProtocol": {
                "enable": true,
                "scope": {
                    "allow": []
                }
            }
        }
    },
    "bundle": {
        "active": true,
        "targets": [
            "nsis"
        ],
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.ico"
        ],
        "windows": {
            "nsis": {
                "installerHooks": "nsis/hooks.nsh"
            }
        },
        "createUpdaterArtifacts": "v1Compatible"
    },
    "plugins": {
        "updater": {
            "pubkey": "__TAURI_UPDATER_PUBKEY__",
            "endpoints": [
                "https://github.com/Eszuri/symvonia/releases/latest/download/latest.json"
            ]
        }
    }
}
